{
  "name": "backend",
  "version": "1.0.0",
  "description": "Smart Academic Resource Hub - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run tests/provision-admin.integration.test.ts",
    "provision-admin": "ts-node-dev --transpile-only src/scripts/provisionAdmin.ts",
    "report-resource-delivery": "ts-node-dev --transpile-only src/scripts/reportResourceDeliveryModes.ts",
    "verify-cloudinary-resource-delivery": "ts-node-dev --transpile-only src/scripts/verifyCloudinaryResourceDelivery.ts",
    "migrate-resource-delivery": "ts-node-dev --transpile-only src/scripts/migrateResourceDelivery.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "axios": "^1.15.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.0.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
